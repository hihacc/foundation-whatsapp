# TFC WhatsApp Service - Environment Configuration Template
# Copy this file to .env and fill in your values. NEVER commit the .env file.

NODE_ENV=development
PORT=4000

# Dedicated Supabase / PostgreSQL Database Connection (Separate from TFC Main DB)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Supabase API Credentials
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_PUBLISHABLE_KEY="[YOUR-SUPABASE-PUBLISHABLE-KEY]"
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SUPABASE-SERVICE-ROLE-KEY]"

# Redis Instance URL (Upstash Redis or Local Redis)
REDIS_URL="redis://localhost:6379"

# Shared Secret Authentication Key between TFC Portal and this Service
TFC_SERVICE_API_KEY="tfc_live_secret_service_key_change_in_production"

# AES-256 Key for WhatsApp Session Encryption (Min 32 characters)
WHATSAPP_SESSION_ENCRYPTION_KEY="replace_with_a_secure_random_32_character_key"

# Logging & Storage
LOG_LEVEL="info"
CORS_ORIGIN="*"
SESSIONS_STORAGE_DIR="./data/sessions"
